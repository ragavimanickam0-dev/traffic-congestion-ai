APP_ENV=development
APP_NAME="TrafficIntel AI"
DEBUG=True

HOST=127.0.0.1
PORT=8000

SECRET_KEY=change_this_to_a_super_secure_random_key_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default development: SQLite (zero configuration required)
DATABASE_URL=sqlite:///./traffic_intel.db
SQLITE_FALLBACK_URL=sqlite:///./traffic_intel.db

# Production MySQL Example:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/traffic_prediction_db

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

OPENWEATHER_API_KEY=
TOMTOM_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
